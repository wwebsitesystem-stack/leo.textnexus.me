{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leo-textnexus-me",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leo-textnexus-me",
      "database_id": "9c4f1b2a-7d63-4e51-9a0f-3b6c8d2e14a9"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "lrosasaamot001@stpaul.k12.mn.us"
  },
  "observability": {
    "enabled": true
  }
}
